{
  "name": "@tripcord/server",
  "private": true,
  "version": "0.0.1",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build -w @tripcord/js",
    "build": "tsc",
    "start": "node dist/index.js",
    "admin": "npm run build --silent && node dist/cli.js",
    "test": "vitest run",
    "pretypecheck": "npm run build -w @tripcord/js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.3.0",
    "@tripcord/js": "^0.2.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testcontainers/postgresql": "^10.13.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
