# Copy to .env next to docker-compose.yml.
# Generate with: openssl rand -hex 32  (hex keeps it safe inside DATABASE_URL)
POSTGRES_PASSWORD=
# The URL people open the dashboard at, e.g. https://tripcord.example.com
PUBLIC_URL=
# Pin a minor version; see "Upgrading" in docs/self-hosting.md
TRIPCORD_VERSION=0.3
# invite-only (default) or open
SIGNUP=invite-only
# true when running behind a reverse proxy
TRUST_PROXY=true
RETENTION_DAYS=30
# Timelines accepted per project per minute; raise it if you capture frequent moments
RATE_LIMIT_MAX=100
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Email, for password reset and emailed invites. Set both or neither.
# URL-encode special characters in the password.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=Tripcord <no-reply@example.com>
